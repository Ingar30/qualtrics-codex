# Reference only. Do not store real credentials in this repository.
# Recommended Windows PowerShell location:
#   $HOME\.secrets\qualtrics.env.ps1
#
# Example PowerShell file contents:
#   $env:QUALTRICS_API_TOKEN = "..."
#   $env:QUALTRICS_DATACENTER = "..."
#   $env:QUALTRICS_PUBLIC_HOST = "yourbrand.qualtrics.com"

QUALTRICS_API_TOKEN=
QUALTRICS_DATACENTER=

# Optional. Use this if your respondent-facing Qualtrics host differs from
# the API datacenter host, e.g. yourbrand.qualtrics.com.
QUALTRICS_PUBLIC_HOST=
