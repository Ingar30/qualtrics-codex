# Secrets
.env
*.env
.secrets/
.Rhistory

# Python
.venv/
__pycache__/
.pytest_cache/

# Qualtrics data and generated outputs
data/*/raw/
data/*/processed/
data/*/metadata/*.json
data/*/metadata/*.log

# Survey specs and slide folders are private by default.
# Promote only canonical public demos by allowlisting them here.
code/*
!code/repo_smoke_test/
!code/repo_smoke_test/**
!code/discrimination_beliefs_demo/
!code/discrimination_beliefs_demo/**
slides/*
!slides/repo_smoke_test/
!slides/repo_smoke_test/**
!slides/discrimination_beliefs_demo/
!slides/discrimination_beliefs_demo/**

# Keep generated Python bytecode ignored even inside allowlisted examples.
**/__pycache__/
*.pyc

slides/*/inputs/*.md
slides/*/inputs/*.tex
slides/*/inputs/*.png
slides/*/inputs/*.pdf
build/
site/*

# OS/editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Keep placeholders
!data/.gitkeep
!slides/*/inputs/.gitkeep
!site/.gitkeep
